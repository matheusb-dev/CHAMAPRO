<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Chamapro.Api</RootNamespace>
		<UserSecretsId>chamapro-api-dev</UserSecretsId>
		<DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Tests/**/*.cs" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
	</ItemGroup>

</Project>
